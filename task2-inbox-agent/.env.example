# Port for Inbox Agent backend & Human Review Web Interface
PORT=3000

# Base URL of Task 1 Knowledge Brain API
KNOWLEDGE_BRAIN_URL=http://localhost:8000

# Timeout in milliseconds when communicating with Task 1
KNOWLEDGE_BRAIN_TIMEOUT_MS=4000

# Provider mode for Knowledge Brain queries ("local_retrieval" or "mock")
AI_PROVIDER=local_retrieval

# Set to "true" for standalone offline development without running Task 1 service
MOCK_KNOWLEDGE_BRAIN=false

# Optional: Claude API key for future integration. Keep empty/commented during local development.
# ANTHROPIC_API_KEY=
