# AI Tech Consultant - Knowledge Brain Configuration
APP_ENV=development
APP_PORT=8000

# SQLite Database Location (defaults to data/knowledge_brain.db)
# DATABASE_PATH=data/knowledge_brain.db

# Provider Configuration:
# - "local_retrieval": Uses local SQLite FTS5 index of ingested documentation (grounded answers + citations).
# - "mock": Uses offline mock provider for consulting domain test responses (default).
# - Future: "claude"
AI_PROVIDER=local_retrieval

# Optional: Claude API key for future integration.
# Keep commented or empty when using local retrieval or mock provider.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
